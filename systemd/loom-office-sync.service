[Unit]
Description=Sync Loom Office completion state into Loom Working tasks
After=default.target

[Service]
Type=oneshot
WorkingDirectory=%h/.local/share/caelestia/plugins/loom
ExecStart=/usr/bin/python3 %h/.local/share/caelestia/plugins/loom/scripts/tabby_loom_sync.py
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.config/tabby %h/.local/state/tabby %t
