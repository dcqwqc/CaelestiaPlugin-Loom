{
  "name": "Loom",
  "version": "0.3.0",
  "author": "dcqwqc",
  "homepage": "https://github.com/dcqwqc/CaelestiaPlugin-Loom",
  "icon": "smart_toy",
  "description": "Customizable desktop AI companion for Caelestia. User-defined name, voice wake and goodbye phrases, and aliases through Protocol7.",
  "entryPoints": [
    {
      "type": "custom",
      "source": "Main.qml"
    },
    {
      "type": "shell-panel",
      "source": "Panel.qml",
      "properties": {
        "edge": "top",
        "alignment": "center",
        "interactive": true,
        "deformAmount": 0.025,
        "motionDuration": 180
      }
    }
  ],
  "settings": "Settings.qml"
}
